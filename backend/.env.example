# ── Banco de Dados (PostgreSQL — servidor próprio) ──────────────────
# Use um usuário de banco dedicado à aplicação (não "postgres"), com acesso
# apenas ao banco conexao_esporte. Veja DEPLOY.md para o passo a passo.
DATABASE_URL=postgresql://conexao_esporte_app:troque_esta_senha@localhost:5432/conexao_esporte

# ── JWT ───────────────────────────────────────────────────────────
# Gere um valor forte com: openssl rand -hex 32
# Em produção (ENVIRONMENT=production) a aplicação recusa subir com o valor
# padrão de desenvolvimento abaixo — é obrigatório trocar.
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────
# development | production — em "production" o Swagger/ReDoc ficam desligados.
ENVIRONMENT=development
# Domínio(s) exato(s) do frontend em produção, separados por vírgula.
# Ex.: CORS_ORIGINS=https://app.conexaoesporte.org.br
CORS_ORIGINS=http://localhost:5173

# ── Upload de documentos de beneficiários ───────────────────────────
# Armazenamento local em disco (ver app/infrastructure/storage). Aponte para
# um caminho fora do repositório em produção e inclua-o no backup do servidor.
UPLOAD_DIR=uploads/documentos
UPLOAD_MAX_SIZE_MB=10

# ── Email (Gmail via OAuth2/XOAUTH2) ────────────────────────────────
# Enquanto essas 4 variáveis não estiverem preenchidas, o sistema NÃO envia
# email nenhum (fica só registrado no log) — seguro deixar em branco em dev.
#
# Como gerar client_id/client_secret/refresh_token (uma vez só, por quem
# administra a conta Gmail/Workspace que vai enviar os emails do sistema):
#   1. Acesse https://console.cloud.google.com/ , crie (ou reaproveite) um
#      projeto, e em "APIs e Serviços" > "Credenciais" > "Criar credenciais"
#      > "ID do cliente OAuth", tipo de aplicativo "Aplicativo da Web".
#   2. Em "URIs de redirecionamento autorizados", adicione a URL de onde
#      você vai rodar o gerador de token (ex.: http://localhost/phpmailer/
#      get_oauth_token.php, se for usar o script que já vem no PHPMailer em
#      https://github.com/PHPMailer/PHPMailer/blob/master/get_oauth_token.php
#      — é só um script auxiliar de geração de token, não precisa do
#      PHPMailer rodando de verdade; qualquer servidor PHP local serve).
#   3. Em "Tela de consentimento OAuth", adicione o escopo
#      "https://mail.google.com/" e inclua a própria conta Gmail/Workspace
#      remetente como usuário de teste (enquanto o app OAuth não for
#      publicado/verificado pelo Google).
#   4. Copie o Client ID e o Client Secret gerados no passo 1.
#   5. Rode o get_oauth_token.php, selecione "Google", cole o Client ID e o
#      Client Secret, e faça login com a conta Gmail/Workspace remetente
#      quando o Google pedir. Ao final ele mostra o "Refresh Token" — copie.
#      Alternativa sem PHP: o OAuth 2.0 Playground
#      (https://developers.google.com/oauthplayground) também gera um
#      refresh token para o escopo "https://mail.google.com/", usando suas
#      próprias credenciais de cliente (engrenagem no canto > "Use your own
#      OAuth credentials").
# O refresh_token não expira sozinho (só se revogado, trocado de senha, ou
# ficar 6 meses sem uso) — gerar uma vez só é suficiente.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Endereço Gmail/Workspace dono da autorização acima (quem os emails saem "de").
EMAIL_REMETENTE=
EMAIL_REMETENTE_NOME=Conexão Esporte

# URL do frontend em produção, usada para montar links clicáveis nos emails
# (ex.: link de redefinição de senha).
FRONTEND_URL=http://localhost:5173
