# ── Banco de Dados (Supabase Postgres) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conexao_esporte

# ── Supabase (opcional, usado se quiser Storage/Realtime além do Postgres) ──
