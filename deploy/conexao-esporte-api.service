[Unit]
Description=Conexao Esporte API (FastAPI, Gunicorn + Uvicorn workers)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=conexao_esporte
Group=conexao_esporte
WorkingDirectory=/home/conexao_esporte/conexao-esporte/backend
ExecStart=/home/conexao_esporte/conexao-esporte/backend/.venv/bin/gunicorn app.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 4 \
    --bind 127.0.0.1:8010 \
    --access-logfile - \
    --error-logfile -
# Recarrega o código com troca gradual dos workers, sem derrubar conexões
# em andamento (use depois de git pull + pip install, antes de um restart completo).
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening (systemd sandbox)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Mudar para read-only permite que o serviço acesse /home/conexao_esporte sem bloquear o boot
ProtectHome=read-only
# Libera permissão de escrita especificamente para a pasta de uploads
ReadWritePaths=/home/conexao_esporte/conexao-esporte/backend/uploads

[Install]
WantedBy=multi-user.target